# ==========================================
# 🔑 API KEYS & CREDENTIALS
# ==========================================
# Google AI Studio se free API key hasil karein (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 🎯 CHANNEL & NICHE SETTINGS
# ==========================================
# Apne channel ka main topic / niche likhein
CHANNEL_NICHE=Artificial Intelligence & Future Tech

# Voice-Over Selection (Male ya Female)
VOICE_GENDER=Male

# Voice Code (Options: en-US-GuyNeural, en-US-JennyNeural, en-US-ChristopherNeural, en-US-AriaNeural, en-GB-RyanNeural, en-GB-SoniaNeural, ur-PK-AsadNeural, ur-PK-UzmaNeural)
VOICE_NAME=en-US-GuyNeural

# ==========================================
# 🎨 VISUAL / IMAGE GENERATION PREFERENCES
# ==========================================
# Video images ka art style
IMAGE_STYLE=Cinematic, Photorealistic, 8k, Octane render, Dramatic lighting

# Har video ke liye images ki tadad (Default: 110 images)
IMAGES_PER_VIDEO=110

# Target script word count (1500-1600 words)
TARGET_WORD_COUNT=1550

# ==========================================
# ⏰ DAILY AUTOMATION & SCHEDULER
# ==========================================
# Rozana video run hone ka time (24-hour format HH:MM, e.g. 10:00 ya 18:30)
SCHEDULE_TIME=10:00

# Daily Auto Schedule On/Off (true ya false)
AUTO_RUN_ENABLED=true

# ==========================================
# 📺 YOUTUBE PUBLISHING SETTINGS
# ==========================================
# Options: public, unlisted, private
YOUTUBE_PRIVACY_STATUS=public
